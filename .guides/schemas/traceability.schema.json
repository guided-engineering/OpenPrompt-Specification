{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guided Engineering Traceability Matrix Schema",
  "description": "Mapping between requirements, specs, acceptance criteria, test cases, commits, and evidence artifacts.",
  "type": "object",
  "required": [
    "apiVersion",
    "matrixId",
    "version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "type": "string",
      "const": "guided-engineering/v1"
    },
    "matrixId": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirementId",
          "specId"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "specId": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "acceptanceCriterionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9._-]+$"
            }
          },
          "testCaseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Commit SHA or short SHA."
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "File path or URL to a concrete artifact (test output, report, log)."
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
